# /etc/systemd/system/alitqan-ai-voice.service
# Alitqan AI voice service: the AI calling agent test (python -m ai_voice; compose service `ai-voice`).
# Idle until AI_VOICE_ENABLED=1 and AI_VOICE_PBX_HOST / AI_VOICE_LOCAL_IP / AI_VOICE_SIP_USER /
# AI_VOICE_SIP_SECRET are set (docs/alitqan-ai-calling-agent-plan.md). It starts every SIP and RTP
# flow itself (the PBX cannot open a connection to the app server).
[Unit]
Description=Alitqan AI voice service (AI calling agent test)
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=cawp
Group=cawp
WorkingDirectory=/opt/alitqan/CAWP-API
EnvironmentFile=/etc/alitqan/api.env
# the calling agent's own model (AI_MODEL_REALTIME=gpt-live-1, 2026-11-05); optional, overrides api.env
EnvironmentFile=-/etc/alitqan/ai-voice.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/opt/alitqan-runtime/venv/bin/python -m ai_voice
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
