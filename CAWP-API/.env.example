# Copy to .env for running the API directly on the host (outside Docker)
FLASK_APP=app.py
FLASK_DEBUG=1
PORT=9797
DATABASE_URL=postgresql+psycopg2://postgres:101016@127.0.0.1:5433/mydata
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
JWT_SECRET_KEY=dev-secret-change-me
SECRET_KEY=dev-secret-change-me
CORS_ORIGINS=*
CDR_HOST=10.10.0.220
CDR_DB=asteriskcdrdb
CDR_USER=crm
CDR_PASSWORD=Admin123@123
CDR_CONNECT_TIMEOUT=3
UPLOAD_DIR=./uploads
WEB_CONCURRENCY=1
GUNICORN_THREADS=32

# Call recordings (SSH/SFTP on the Asterisk box). Uncomment to override the defaults
# baked into core/config.py. Only paths under RECORDINGS_ROOT can be downloaded.
#RECORDINGS_ROOT=/var/spool/asterisk/monitor/
#RECORDINGS_SSH_HOST=10.10.0.220
#RECORDINGS_SSH_USER=root
#RECORDINGS_SSH_PASSWORD=
#RECORDINGS_SSH_KEY=/root/.ssh/id_rsa
